# Socrates (Redmi K60 Pro) - SukiSU Ultra + KPM + SUSFS
#
# Merged on top of, in this order:
#   arch/arm64/configs/gki_defconfig
#   arch/arm64/configs/vendor/kalama_GKI.config
#   arch/arm64/configs/vendor/socrates_GKI.config
#   arch/arm64/configs/vendor/socrates-sukisu.config   <-- this file
#
# The build script exports an empty LOCALVERSION variable, without which
# setlocalversion appends a bare '+'. See the release block at the bottom.

# ---- LTO: thin instead of full (build time and peak memory) ----
# CONFIG_LTO_CLANG_FULL is not set
CONFIG_LTO_CLANG_THIN=y

# ---- KernelSU / SukiSU Ultra ----
CONFIG_KSU=y
CONFIG_KPM=y

# ---- SUSFS ----
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_SUS_MAP=y
CONFIG_KSU_SUSFS_PRIORITY_UID_FILTER=y

# ---- kernel release ----
# Report the version this tree actually declares, with no extra suffix, so
# uname -r reads 5.15.223 (Makefile VERSION/PATCHLEVEL/SUBLEVEL). The stock
# ROM reports 5.15.194-android13-8-00019-gf4321180a397-ab15212794 instead.
#
# That prefix is not what vendor modules are validated on: with
# CONFIG_MODVERSIONS the kernel skips everything before the first space of
# the vermagic and compares only the flags part, so reporting the tree's own
# version does not affect module loading. LOCALVERSION_AUTO stays off so
# setlocalversion does not append -g<hash> for the current checkout.
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_LOCALVERSION=""
